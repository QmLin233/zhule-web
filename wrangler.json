{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "zhule-web",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "zhule"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "zhule",
			"database_id": "placeholder-id"
		}
	],
	"vars": {
		"PUBLIC_BUCKET_URL": "https://cdn.zhule.org"
	}
}
